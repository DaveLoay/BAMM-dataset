# Copy to .env and edit:  cp .env.example .env

# ── Datasets ────────────────────────────────────────────────────────────
# Host folder mounted read-only at /datasets inside the container.
# The dataset configs in configs/datasets/ expect, inside it:
#   fma_medium/                  FMA-medium audio            (CNN Clean, human)
#   sonics_suno_v35/             SONICS Suno v3.5 audio      (CNN Clean, AI)
#   synthetic_broadcast/{Human,AI}/  built with scripts/build_synthetic_broadcast_dataset.py
#   AI-OpenBMAT/                 evaluation (CFM, STB)
#   BAMM/                        evaluation (RTB)
DATASETS_DIR=/path/to/your/datasets

# ── Docker ──────────────────────────────────────────────────────────────
# docker/Dockerfile.gpu -> TF 2.11 GPU image (used for training)
# docker/Dockerfile     -> CPU image
BASE_DOCKERFILE=docker/Dockerfile.gpu
# all | 0 | 1 | 0,1
GPU_DEVICE=all
# Used in the Docker image tag (bamm-detectors-<USER_NAME>)
USER_NAME=your_name

# ── MLflow (optional) ───────────────────────────────────────────────────
# Leave MLFLOW_TRACKING_URI empty to train without MLflow.
# With `make up`, use http://host.docker.internal:5000 (Mac/Windows)
# or http://172.17.0.1:5000 (Linux) to reach the server from the container.
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=
MLFLOW_RUN_USER=
